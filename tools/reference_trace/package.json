{
  "name": "wisteria-reference-trace",
  "private": true,
  "type": "module",
  "description": "MMD community reference trace harness (Phase 0B). Exact dependency versions are pinned; see package-lock.json for integrity.",
  "scripts": {
    "build:trace": "esbuild trace.mjs --bundle --platform=node --format=cjs --outfile=bundle_trace.cjs",
    "build:spike": "esbuild spike_load.mjs --bundle --platform=node --format=esm --outfile=bundle.mjs",
    "calibrate": "node clock_calibration.mjs",
    "trace": "npm run build:trace && node bundle_trace.cjs",
    "spike": "npm run build:spike && node bundle.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.20.0",
    "ammojs-typed": "1.0.6",
    "babylon-mmd": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
